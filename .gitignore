# .NET build output and tool state — the subset of the family's .NET ignore list this repository
# produces today, and the Node / VS Code section for src_vs_code/ (E5.S1).

# Visual Studio / Rider working folders and per-user files
.vs/
.idea/
*.user

# Build results
[Bb]in/
[Oo]bj/

# Publish output (CI and local: dotnet publish -o artifacts/publish/<rid>)
artifacts/

# MSBuild binary and structured logs
*.binlog

# Test results written by the Microsoft Testing Platform runners
[Tt]est[Rr]esult*/

# Host logs: a folder per day, a file per run (.agents/conventions/common/logging-serilog.md)
logs/

# The extension (src_vs_code/, E5.S1): dependencies, the compiled tests, the bundle, packages, test-electron downloads
node_modules/
src_vs_code/out/
src_vs_code/dist/
*.vsix
.vscode-test/
