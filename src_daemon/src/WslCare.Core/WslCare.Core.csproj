<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WslCare.Core</RootNamespace>
    <!-- Collectors, rules, actions and records (plan §8). It ships inside a Native AOT binary on
         every RID, so the trim, AOT and single-file analyzers run on EVERY build of it: a pattern
         AOT cannot compile fails here, under TreatWarningsAsErrors, not on a release runner. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- No reflection-based JSON: every payload goes through WslCareJsonContext (source-generated)
         or is read as a JsonDocument. The flag turns an accidental reflective call into an error. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The LibraryImport source generator emits the marshalling stub for GlobalMemoryStatusEx (the
         Windows probe's host RAM, Collectors/WindowsProbe.cs) as unsafe code. That stub is the only
         unsafe code in the project; nothing is written with the keyword by hand. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The default configuration layer (plan §6), embedded so the binary carries its own defaults
         and `config get` can name the layer a value came from. Its keys are held to ConfigKeys by a
         test in both directions. -->
    <EmbeddedResource Include="Config\default.json" LogicalName="WslCare.Core.Config.default.json" />
    <!-- The AI-agent catalogue (plan §4.6, §15q E7.S1): data, not code — discovery, the daily walk and the protected roots
         all read it. -->
    <EmbeddedResource Include="Agents\agents.json" LogicalName="WslCare.Core.Agents.agents.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WslCare.Core.Tests" />
    <InternalsVisibleTo Include="WslCare.Cli.Tests" />
  </ItemGroup>

</Project>
