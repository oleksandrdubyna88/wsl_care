<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>wsl-care</AssemblyName>
    <RootNamespace>WslCare.Cli</RootNamespace>
    <!-- Native AOT, the same choice as the family's `creds` CLI and for the same reasons: one
         self-contained binary with no runtime to install in the distro (plan §2), and the trim/AOT
         analyzers then run on EVERY build, so an incompatible pattern fails at compile time rather
         than on a release runner. -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <!-- No reflection-based JSON anywhere: every payload will go through a source-generated
         context (plan §8). This turns an accidental reflective call into an error. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The RIDs this binary ships for (plan §9, §15 #15): linux-x64 and linux-arm64 for the distro,
         win-x64 for the Windows probe bundled in the extension. Listed so restore fetches each one's
         AOT packs and a misspelt RID fails restore instead of a release leg. Native AOT does not
         cross-compile across operating systems, so each is published on its own runner. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WslCare.Core\WslCare.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WslCare.Cli.Tests" />
  </ItemGroup>

</Project>
