<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RootNamespace>WslCare.Cli.Tests</RootNamespace>
    <!-- The CLI forbids reflection-based JSON so AOT failures surface at compile time. The test
         project inherits the rule rather than testing a laxer configuration than ships. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 does not contribute an implicit using of its own. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the CLI's source is, for the scan that holds every stream write to Output and the
         console sink: stamped by the build rather than walked up to from the test binary. -->
    <AssemblyMetadata Include="WslCare.CliSourceRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\WslCare.Cli'))" />
    <!-- The shipped units, read where they live: UnitSuccessExitTests holds each unit's SuccessExitStatus to the exits the
         program's recorded endings return (retro round over PR #11). -->
    <AssemblyMetadata Include="WslCare.SystemdDirectory" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\systemd'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- The captured procfs / cgroup trees (fixtures/procfs/*/SOURCE.txt says what, when and how), copied
         beside the runner as fixtures/procfs/… for TestSupport.ProcfsFixture. -->
    <None Include="..\fixtures\**\*" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WslCare.Cli\WslCare.Cli.csproj" />
    <ProjectReference Include="..\WslCare.TestSupport\WslCare.TestSupport.csproj" />
  </ItemGroup>

</Project>
