<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RootNamespace>WslCare.Core.Tests</RootNamespace>
    <!-- The product forbids reflection-based JSON so AOT failures surface at compile time. The test
         project inherits the rule rather than testing a laxer configuration than ships. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The LibraryImport stubs of the inotify watch (Agents/AgentNoOpenTests.cs, plan §15q H3) are generated unsafe code;
         nothing in the tests is written with the keyword by hand. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 does not contribute an implicit using of its own. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the daemon's version file is, as MSBuild resolved it for the stamp — read back by the
         test that checks the stamp, rather than re-derived from a guessed relative path. -->
    <AssemblyMetadata Include="WslCare.VersionFile" Value="$(WslCareVersionFile)" />
    <!-- Where the product source is, for the architecture test that scans it: stamped by the build
         for the same reason — a path walked up from the test binary is a guess that breaks in a
         relocated build. -->
    <AssemblyMetadata Include="WslCare.SourceRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src'))" />
    <!-- The sanctioned seam files, so the companion test proving the scanner is alive names them from
         one place rather than retyping their paths. -->
    <AssemblyMetadata Include="WslCare.FileSystemSeam" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\WslCare.Core\Files\PhysicalFileSystem.cs'))" />
    <AssemblyMetadata Include="WslCare.ProcessSeam" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\WslCare.Core\Processes\ProcessCommandRunner.cs'))" />
    <AssemblyMetadata Include="WslCare.SignalSeam" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\WslCare.Core\Processes\ProcessSignals.cs'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- The captured procfs / cgroup trees (fixtures/procfs/*/SOURCE.txt says what, when and how), copied
         beside the runner as fixtures/procfs/… for TestSupport.ProcfsFixture. -->
    <None Include="..\fixtures\**\*" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WslCare.Core\WslCare.Core.csproj" />
    <ProjectReference Include="..\WslCare.TestSupport\WslCare.TestSupport.csproj" />
  </ItemGroup>

</Project>
