<Project>

  <!--
    Every project in the repository, mirrored from the family's credential-store repository so the
    two build the same way: .NET 10, nullable on, every warning an error (the trim and AOT analyzers
    included, which is what makes "zero AOT warnings" a build failure rather than a release-day
    surprise), versions managed centrally in Directory.Packages.props, and no ICU dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
